# ============================================================================
# Universal RAG — environment secrets.  Copy to `.env` and fill in.
# `config/config.yaml` references these by name; secrets never live in YAML.
# ============================================================================

# --- Postgres / pgvector (matches docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=universal_rag
POSTGRES_USER=urag
POSTGRES_PASSWORD=change-me
# Full DSN is derived from the above; override only if needed.
# DATABASE_URL=postgresql+psycopg://urag:change-me@localhost:5432/universal_rag

# --- Ollama (host-run; embeddings + optional retrieval reranker) ---
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text task prefixes (improve retrieval quality). Blank these out
# for models that don't use prefixes (e.g. mxbai-embed-large).
EMBED_DOC_PREFIX=search_document:
EMBED_QUERY_PREFIX=search_query:
# Optional retrieval reranker (any installed Ollama chat model). Blank = no rerank.
RERANK_MODEL=

# --- Connector credentials (only fill in the ones you use) ---
# Confluence Data Center / Server — authenticates with a Personal Access Token
# (Profile > Settings > Personal Access Tokens) sent as `Authorization: Bearer`.
CONFLUENCE_BASE_URL=https://confluence.your-org.com
CONFLUENCE_PAT=
# Set to false only if your Confluence uses an internal/self-signed certificate.
CONFLUENCE_VERIFY_SSL=true

# Jira Data Center / Server — same PAT bearer scheme as Confluence (a separate
# token from your own Jira instance). Base URL is the Jira site root.
JIRA_BASE_URL=https://jira.your-org.com
JIRA_PAT=
JIRA_VERIFY_SSL=true

# GitHub — a fine-grained PAT or classic token with repo/read scopes, sent as
# `Authorization: Bearer`. For GitHub Enterprise Server, point the API URL at
# https://<host>/api/v3 (default is github.com's public API).
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Microsoft Graph (SharePoint / OneDrive) — app-only client-credentials flow.
# Register an Azure AD app, grant admin-consented APPLICATION permissions
# Sites.Read.All + Files.Read.All, and create a client secret.
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
# Defaults below are standard; override only for sovereign/national clouds.
MSGRAPH_AUTHORITY=https://login.microsoftonline.com
MSGRAPH_BASE_URL=https://graph.microsoft.com/v1.0
