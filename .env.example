# ============================================================================
# Universal RAG — environment secrets.  Copy to `.env` and fill in.
# `config/config.yaml` references these by name; secrets never live in YAML.
# ============================================================================

# --- Postgres / pgvector (matches docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=universal_rag
POSTGRES_USER=urag
POSTGRES_PASSWORD=change-me
# Full DSN is derived from the above; override only if needed.
# DATABASE_URL=postgresql+psycopg://urag:change-me@localhost:5432/universal_rag

# --- Ollama (host-run; embeddings + generation fallback) ---
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Reranker + generation fallback models (any installed Ollama chat model)
RERANK_MODEL=
OLLAMA_GENERATION_MODEL=qwen2.5-coder:14b-instruct

# --- Generation provider selection ---
# Default chain: github_copilot (if CLI present) -> ollama
LLM_PROVIDER=auto   # auto | github_copilot | ollama

# --- Connector credentials (only fill in the ones you use) ---
# Atlassian (Confluence + Jira) — one API token covers both for a cloud site.
ATLASSIAN_BASE_URL=https://your-org.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# GitHub — a fine-grained PAT or classic token with repo/read scopes.
GITHUB_TOKEN=

# --- (Later) Microsoft Graph for SharePoint/OneDrive ---
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
